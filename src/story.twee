:: StoryData
{
  "ifid": "AC5FB15F-7DE0-4294-AE21-DC1499CD5FF6",
  "format": "SugarCube",
  "format-version": "2.37.3",
  "start": "Awakening",
  "tag-colors": {
    "StoryInit": "gray",
    "stylesheet": "gray",
    "ending": "red"
